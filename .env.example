# Copy this file to .env and fill in your values. Never commit .env.

# Supabase dashboard > Connect > Transaction pooler (port 6543).
# Replace [YOUR-PASSWORD] with your database password (percent-encode @ # ? & / : and spaces).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# Optional locally. Required on Vercel (generate one with the command in the README).
# DJANGO_SECRET_KEY=
